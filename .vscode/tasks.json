{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Vite dev server",
      "type": "shell",
      "command": "pnpm",
      "args": ["dev", "--", "--host", "127.0.0.1"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^> vite",
          "endsPattern": "http://127\\.0\\.0\\.1:8443/"
        }
      }
    }
  ]
}
